---
const { title, description, canonical, wide } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/logo.png" />
  <link rel="apple-touch-icon" href="/logo.png" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://agents.artifactstech.com/logo.png" />
  <meta name="twitter:card" content="summary" />
  <link rel="alternate" type="text/markdown" href="/agents.md" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  <slot name="head" />
  <style is:global>
    :root {
      --cream:#FAF6EA; --ink:#171310; --mut:#6b655a; --rule:#d9d3c0; --link:#7A46E8;
      --violet:#8C52FF; --green:#0DA65C; --blue:#4BB4F1; --orange:#F88137;
      --sans:"Archivo", system-ui, -apple-system, sans-serif;
      --mono:"Space Mono", ui-monospace, "SF Mono", Menlo, monospace;
    }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--cream); color:var(--ink); font:17px/1.62 var(--sans); -webkit-font-smoothing:antialiased; }
    .page { max-width:44rem; margin:0 auto; padding:32px 22px 64px; }
    a { color:var(--link); text-underline-offset:3px; }
    a:hover { color:var(--ink); }
    p { margin:0 0 1em; }
    code, pre { font-family:var(--mono); font-size:.8em; }
    h1, h2 { font-weight:600; margin:0; }
    h1 { font-size:clamp(34px, 6vw, 48px); line-height:1.1; letter-spacing:-.02em; }
    h2 { font-size:20px; line-height:1.3; letter-spacing:-.005em; margin-bottom:.6em; }
    header.top { display:flex; align-items:center; gap:12px; margin-bottom:clamp(12px,2.5vh,20px); }
    header.top img { width:36px; height:36px; display:block; }
    header.top a { color:var(--ink); text-decoration:none; font-weight:600; }
    header.top span { color:var(--mut); font-weight:400; }
    .rule { display:grid; gap:3px; margin:20px 0 clamp(40px, 9vh, 88px); }
    .rule i { display:block; height:3px; }
    .rule i:nth-child(1){background:var(--violet)} .rule i:nth-child(2){background:var(--green)}
    .rule i:nth-child(3){background:var(--blue)}   .rule i:nth-child(4){background:var(--orange)}
    .page { transition:max-width .35s ease; }
    .page.wide.open { max-width:74rem; }
    section { margin-top:3rem; }
    footer.site { margin-top:4rem; color:var(--mut); font-size:14px; }
    :focus-visible { outline:2px solid var(--ink); outline-offset:3px; }
  </style>
</head>
<body>
<div class:list={["page", { wide }]}>
  <header class="top">
    <a href="/" aria-label="Artifacts for agents"><img src="/logo.png" alt="Artifacts" width="36" height="36" /></a>
    <a href="/">Artifacts <span>for agents</span></a>
  </header>
  <slot />
  <footer class="site">Every issue links back to its Substack original. CC BY 4.0. Lorenzo Ancona.</footer>
</div>
</body>
</html>

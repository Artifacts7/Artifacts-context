---
import { readFileSync } from "node:fs";
import Base from "../layouts/Base.astro";
const issues = JSON.parse(readFileSync(`${process.cwd()}/public/api/issues.json`, "utf8"));
const en = issues.filter((i) => i.lang === "en").length;
const latest = issues[0];
const slug = issues[0].slug;
const D = "https://agents.artifactstech.com";
const prompt = `Connect to the Artifacts newsletter mirror and help me explore it.

1. Add the remote MCP server at ${D}/mcp (read-only, no sign-in). If you cannot add MCP servers, read ${D}/agents.md and use its search API and llms.txt instead.
2. Check that the tools search_issues, get_issue and list_issues work.
3. Briefly explain what Artifacts is (a newsletter by Lorenzo Ancona on the design of technology; ${issues.length} issues, CC BY 4.0), then ask what I want to explore and suggest a first search.
4. Cite every answer with the issue's cite_as field and link its Substack canonical.
`;

const endpoints = [
  ["/llms.txt", "/llms.txt", "Index of every issue"],
  ["/llms-full.txt", "/llms-full.txt", "The whole corpus in one file"],
  ["/issues/<slug>.md", `/issues/${slug}.md`, "One issue as Markdown"],
  ["/issues/<slug>.json", `/issues/${slug}.json`, "One issue as JSON"],
  ["/api/search?q=", "/api/search?q=defaults+power", "Ranked search with snippets"],
  ["/api/issues.json", "/api/issues.json", "All metadata"],
  ["/mcp", null, "MCP server: search_issues, get_issue, list_issues"],
  ["/.well-known/agents.json", "/.well-known/agents.json", "Discovery manifest"],
];
const ld = {
  "@context": "https://schema.org", "@type": "Blog", name: "Artifacts (for agents)",
  author: { "@type": "Person", name: "Lorenzo Ancona" },
  license: "https://creativecommons.org/licenses/by/4.0/",
  isBasedOn: "https://artifactstech.substack.com",
};
---
<Base
  title="Artifacts, for agents"
  description="A machine mirror of the Artifacts newsletter. Built for AI agents. Humans: read it on Substack."
  canonical="https://agents.artifactstech.com/"
  wide
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style is:global>
    body { transition:background-color .45s ease; }
    body[data-view="humans"] { background:#efe7fb; }
  </style>
  <style>
    .layout { display:grid; grid-template-columns:minmax(0,1fr); gap:32px; align-items:start; }
    .layout.has-viewer { grid-template-columns:minmax(0,38rem) minmax(0,1fr); }
    .viewer { background:var(--ink); color:var(--cream); flex-direction:column; min-width:0; display:none; overflow:hidden; }
    .viewer.open { display:flex; }
    .vbar { display:flex; gap:12px; align-items:center; padding:18px 18px 10px; font:400 13px var(--mono); color:#8a8374; }
    .vbar .url { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .vbar button, .vbar a { font:700 12px var(--mono); background:none; border:0; color:var(--cream); cursor:pointer; padding:0; text-decoration:underline; text-underline-offset:3px; }
    .vbody { flex:1; overflow:auto; margin:0; padding:0 18px 18px; font:400 13px/1.7 var(--mono); color:#a9a291; white-space:pre-wrap; overflow-wrap:anywhere; }
    .vbody.empty { color:var(--mut); }
    .res { padding:10px 0; border-bottom:1px solid #3a342b; }
    .res:last-child { border:0; }
    .res a { font-family:var(--mono); font-size:13px; color:var(--blue); }
    .res div { color:#a9a291; font-size:12px; margin-top:2px; }
    .term form { display:flex; gap:8px; margin:1em 0 0; }
    .term input { flex:1; min-width:0; background:transparent; color:var(--cream); border:0; border-bottom:1px solid #8a8374; font:inherit; padding:2px 0; outline:0; }
    .term input:focus { border-color:var(--green); }
    .term .go { background:none; border:1px solid #8a8374; color:var(--cream); font:inherit; padding:2px 10px; cursor:pointer; }
    .term a.peek { color:inherit; text-decoration:underline; text-decoration-color:#6b655a; text-underline-offset:3px; }
    .term a.peek:hover, .term a.peek.on { color:var(--blue); }
    @media (max-width:960px) {
      .layout, .layout.has-viewer { grid-template-columns:minmax(0,1fr); }
      .viewer { height:60vh !important; }
    }
    .lede { font-size:18px; max-width:34rem; margin:1rem 0 1.6rem; }
    .pur { color:var(--link); font-weight:600; }
    .human { margin:0; font-size:18px; display:flex; flex-wrap:wrap; align-items:center; gap:10px; }
    .cta { display:inline-flex; align-items:center; gap:14px; background:#fff; color:var(--ink); border:0; border-radius:999px; padding:6px 18px 6px 6px; cursor:pointer; font:600 16px var(--sans); box-shadow:0 1px 2px rgba(23,19,16,.12), 0 4px 14px rgba(23,19,16,.08); transition:box-shadow .15s, transform .1s; }
    .cta:hover { box-shadow:0 1px 2px rgba(23,19,16,.16), 0 6px 18px rgba(23,19,16,.14); }
    .cta:active { transform:scale(.98); }
    .logos { display:flex; }
    .logos i { width:34px; height:34px; border-radius:50%; background:#fff; border:1px solid #dcd6c6; display:grid; place-items:center; margin-left:-8px; }
    .logos i:first-child { margin-left:0; }
    .logos svg { width:18px; height:18px; }
    .cp { width:18px; height:18px; color:var(--mut); }
    .or { font:400 13px var(--mono); color:var(--mut); margin:.25rem 0 .3rem; }
    .agentline { margin:0 0 .8rem; }
    .stage { perspective:1400px; }
    .flip { position:relative; transition:transform .5s cubic-bezier(.3,.7,.2,1); transform-style:preserve-3d; }
    .flip[data-view="humans"] { transform:rotateY(180deg); }
    .face { backface-visibility:hidden; -webkit-backface-visibility:hidden; }
    .face.back { position:absolute; inset:0 0 auto 0; transform:rotateY(180deg); }
    .flip[data-view="agents"] .back, .flip[data-view="humans"] .front { pointer-events:none; }
    .term { background:var(--ink); color:var(--cream); padding:18px 18px 20px; font-family:var(--mono); font-size:13px; line-height:1.7; overflow-wrap:anywhere; }
    .term .bar { color:#8a8374; margin-bottom:10px; }
    .term .c { color:var(--cream); } .term .c::before { content:"$ "; color:var(--green); }
    .term .o { color:#a9a291; margin:0 0 .9em; white-space:pre-wrap; }
    .term a { color:var(--blue); }
    .term dl { margin:.4em 0 0; display:grid; grid-template-columns:max-content 1fr; column-gap:22px; row-gap:.2em; }
    .term dt { color:var(--cream); } .term dd { margin:0; color:#a9a291; }
    .term p { margin:1em 0 0; color:#a9a291; }
    .human { padding:4px 0; }
    .human p { max-width:34rem; }
    .toggle { margin-top:1.4rem; font:700 13px var(--mono); background:none; color:var(--ink); border:1px solid var(--ink); padding:9px 14px; cursor:pointer; }
    .toggle:hover { background:var(--ink); color:var(--cream); }
    @media (max-width:640px){ .term dl { grid-template-columns:1fr; } .term dd { margin-bottom:.5em; } }
    @media (prefers-reduced-motion:reduce){ .flip { transition:none; } }
  </style>

  <h1>This site is <span class="pur">not for humans.</span></h1>
  <p class="lede">It is a mirror of <a href="https://artifactstech.substack.com"><b>Artifacts</b></a>, a newsletter on the design of technology, that has been <b class="pur">built specifically for AI agents.</b></p>

  <div class="layout" id="layout">
  <div class="stage">
    <div class="flip" id="flip" data-view="agents">
      <div class="face front" id="front">
        <p class="human">If you are a human and happen to be here,
          <button class="cta" type="button" data-copy={prompt} aria-label="Copy a prompt that gets your agent to use this site">
            <span class="logos" aria-hidden="true"><i><svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd"><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.724-.491-.364-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.145-.103.019-.073-.164-.274-1.355-2.446-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 01-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.264 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.657-.851-.747-1.926-1.62h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.012-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312-.006.006z"></path></svg></i><i><svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd"><path d="M9.205 8.658v-2.26c0-.19.072-.333.238-.428l4.543-2.616c.619-.357 1.356-.523 2.117-.523 2.854 0 4.662 2.212 4.662 4.566 0 .167 0 .357-.024.547l-4.71-2.759a.797.797 0 00-.856 0l-5.97 3.473zm10.609 8.8V12.06c0-.333-.143-.57-.429-.737l-5.97-3.473 1.95-1.118a.433.433 0 01.476 0l4.543 2.617c1.309.76 2.189 2.378 2.189 3.948 0 1.808-1.07 3.473-2.76 4.163zM7.802 12.703l-1.95-1.142c-.167-.095-.239-.238-.239-.428V5.899c0-2.545 1.95-4.472 4.591-4.472 1 0 1.927.333 2.712.928L8.23 5.067c-.285.166-.428.404-.428.737v6.898zM12 15.128l-2.795-1.57v-3.33L12 8.658l2.795 1.57v3.33L12 15.128zm1.796 7.23c-1 0-1.927-.332-2.712-.927l4.686-2.712c.285-.166.428-.404.428-.737v-6.898l1.974 1.142c.167.095.238.238.238.428v5.233c0 2.545-1.974 4.472-4.614 4.472zm-5.637-5.303l-4.544-2.617c-1.308-.761-2.188-2.378-2.188-3.948A4.482 4.482 0 014.21 6.327v5.423c0 .333.143.571.428.738l5.947 3.449-1.95 1.118a.432.432 0 01-.476 0zm-.262 3.9c-2.688 0-4.662-2.021-4.662-4.519 0-.19.024-.38.047-.57l4.686 2.71c.286.167.571.167.856 0l5.97-3.448v2.26c0 .19-.07.333-.237.428l-4.543 2.616c-.619.357-1.356.523-2.117.523zm5.899 2.83a5.947 5.947 0 005.827-4.756C22.287 18.339 24 15.84 24 13.296c0-1.665-.713-3.282-1.998-4.448.119-.5.19-.999.19-1.498 0-3.401-2.759-5.947-5.946-5.947-.642 0-1.26.095-1.88.31A5.962 5.962 0 0010.205 0a5.947 5.947 0 00-5.827 4.757C1.713 5.447 0 7.945 0 10.49c0 1.666.713 3.283 1.998 4.448-.119.5-.19 1-.19 1.499 0 3.401 2.759 5.946 5.946 5.946.642 0 1.26-.095 1.88-.309a5.96 5.96 0 004.162 1.713z"></path></svg></i><i><svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd"><path d="M22.106 5.68L12.5.135a.998.998 0 00-.998 0L1.893 5.68a.84.84 0 00-.419.726v11.186c0 .3.16.577.42.727l9.607 5.547a.999.999 0 00.998 0l9.608-5.547a.84.84 0 00.42-.727V6.407a.84.84 0 00-.42-.726zm-.603 1.176L12.228 22.92c-.063.108-.228.064-.228-.061V12.34a.59.59 0 00-.295-.51l-9.11-5.26c-.107-.062-.063-.228.062-.228h18.55c.264 0 .428.286.296.514z"></path></svg></i></span>
            <span class="lbl">Get your agents to use it</span>
            <svg class="cp" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><rect x="9" y="9" width="11" height="11" rx="2.5"/><path d="M15 9V6.5A2.5 2.5 0 0 0 12.5 4h-6A2.5 2.5 0 0 0 4 6.5v6A2.5 2.5 0 0 0 6.5 15H9"/></svg>
          </button>
        </p>
        <p class="or">or</p>
        <p class="agentline">If you are an AI agent, read this:</p>
        <div class="term">
          <div class="bar">artifacts-agents ~ {issues.length} issues, {en} en / {issues.length - en} it, CC BY 4.0, read-only</div>
          <div class="c">curl -s <a class="peek" href="/llms.txt">https://agents.artifactstech.com/llms.txt</a></div>
          <div class="c">curl -s "<a class="peek" href="/api/search?q=defaults+power">https://agents.artifactstech.com/api/search?q=defaults+power</a>"</div>
          <div class="c">curl -s <a class="peek" href={`/issues/${slug}.md`}>https://agents.artifactstech.com/issues/{slug}.md</a></div>
          <div class="c">curl -s -H "Accept: text/markdown" https://agents.artifactstech.com/</div>
          <div class="c">claude mcp add --transport http artifacts https://agents.artifactstech.com/mcp</div>
          <p>endpoints</p>
          <dl>{endpoints.map(([p, h, d]) => <><dt>{h ? <a class="peek" href={h}>{p}</a> : p}</dt><dd>{d}</dd></>)}</dl>
          <form id="sf"><span style="color:var(--green)">$ search</span><input id="q" name="q" placeholder="defaults power" autocomplete="off" aria-label="Search issues" /><button class="go" type="submit">run</button></form>
          <p>Full instructions: <a class="peek" href="/agents.md">/agents.md</a>. Cite with each issue's cite_as and link the Substack canonical. Requests are logged privately, without IP addresses.</p>
        </div>
        <button class="toggle" type="button" data-to="humans">For humans</button>
      </div>
      <div class="face back human" id="back" aria-hidden="true">
        <h2>For humans</h2>
        <p>Artifacts is a bi-weekly newsletter by Lorenzo Ancona about how interfaces, defaults and platform choices encode decisions made by those with power. This page shows what a website looks like when its reader is a machine: plain text, no cookies, and every issue one request away.</p>
        <p>You can <a href="/issues/">browse the archive</a> as raw Markdown, or <a href="https://artifactstech.substack.com">read the newsletter on Substack</a>.</p>
        <button class="toggle" type="button" data-to="agents">For agents</button>
      </div>
    </div>
  </div>
  <aside class="viewer" id="viewer" aria-label="File viewer">
    <div class="vbar"><span class="url" id="vurl">viewer</span><button type="button" id="vcopy">copy</button><a id="vraw" href="/llms.txt" target="_blank" rel="noopener">raw</a><button type="button" class="vclose" id="vclose">close</button></div>
    <div class="vbody" id="vbody"></div>
  </aside>
  </div>

  <script is:inline>
    const flip = document.getElementById("flip"), front = document.getElementById("front"), back = document.getElementById("back");
    const size = () => { flip.style.minHeight = Math.max(front.offsetHeight, back.offsetHeight) + "px"; };
    size(); addEventListener("resize", size);
    document.querySelectorAll(".toggle").forEach((b) => b.addEventListener("click", () => {
      const v = b.dataset.to; flip.dataset.view = v; document.body.dataset.view = v;
      if (v === "humans") { viewer.classList.remove("open"); layout.classList.remove("has-viewer"); page.classList.remove("open"); }
      else if (wasOpen) { viewer.classList.add("open"); layout.classList.add("has-viewer"); page.classList.add("open"); fit(); }
      front.setAttribute("aria-hidden", v === "humans"); back.setAttribute("aria-hidden", v === "agents");
      scrollTo({ top: 0 });
    }));
    const page = document.querySelector(".page"), layout = document.getElementById("layout"), viewer = document.getElementById("viewer"), vbody = document.getElementById("vbody"), vurl = document.getElementById("vurl"), vraw = document.getElementById("vraw");
    const termEl = document.querySelector(".term");
    const fit = () => {
      const wide = innerWidth > 960;
      viewer.style.height = wide ? termEl.offsetHeight + "px" : "";
      viewer.style.marginTop = wide ? (termEl.getBoundingClientRect().top - layout.getBoundingClientRect().top) + "px" : "";
    };
    addEventListener("resize", fit);
    document.querySelectorAll("[data-copy]").forEach((b) => b.addEventListener("click", async () => {
      const l = b.querySelector(".lbl") || b, t = l.textContent;
      try { await navigator.clipboard.writeText(b.dataset.copy); l.textContent = "Copied"; } catch { l.textContent = "Copy failed"; }
      setTimeout(() => (l.textContent = t), 1400);
    }));
    let wasOpen = false; const LIMIT = 60000; let current = "";
    const esc = (t) => t.replace(/[&<>]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;" }[c]));
    async function peek(href, a) {
      document.querySelectorAll("a.peek.on").forEach((x) => x.classList.remove("on")); a?.classList.add("on");
      wasOpen = true; viewer.classList.add("open"); layout.classList.add("has-viewer"); page.classList.add("open"); fit(); vurl.textContent = location.origin + href; vraw.href = href; vbody.className = "vbody"; vbody.textContent = "loading...";
      try {
        const r = await fetch(href, { headers: { "x-viewer": "1" } });
        const ct = r.headers.get("content-type") || ""; let t = await r.text();
        if (ct.includes("json")) { try { const j = JSON.parse(t); current = JSON.stringify(j, null, 2);
          if (href.startsWith("/api/search")) { renderSearch(j); return; } t = current; } catch {} } else current = t;
        const cut = t.length > LIMIT; vbody.textContent = cut ? t.slice(0, LIMIT) + "\n\n[truncated, " + Math.round(t.length / 1024) + " KB total. Use raw for the full file.]" : t;
        vbody.scrollTop = 0;
      } catch (e) { vbody.textContent = "Could not load " + href; }
      if (innerWidth <= 960) viewer.scrollIntoView({ behavior: "smooth" });
    }
    function renderSearch(j) {
      if (!j.results.length) { vbody.textContent = "No results for \"" + j.query + "\"."; return; }
      vbody.innerHTML = "<div style='color:#8a8374;margin-bottom:6px'>" + j.count + " results for \"" + esc(j.query) + "\"</div>" +
        j.results.map((x) => `<div class="res"><a href="/issues/${x.slug}.md" data-v>${esc(x.title)}</a><div>${esc(x.date || "")} ${esc(x.language || "")}</div><div>${esc(x.snippet || "")}</div></div>`).join("");
      vbody.querySelectorAll("a[data-v]").forEach((l) => l.addEventListener("click", (e) => { e.preventDefault(); peek(l.getAttribute("href")); }));
      if (innerWidth <= 960) viewer.scrollIntoView({ behavior: "smooth" });
    }
    document.querySelectorAll("a.peek").forEach((a) => a.addEventListener("click", (e) => { e.preventDefault(); peek(a.getAttribute("href"), a); }));
    document.getElementById("sf").addEventListener("submit", (e) => { e.preventDefault(); const q = document.getElementById("q").value.trim(); if (q) peek("/api/search?q=" + encodeURIComponent(q)); });
    document.getElementById("vcopy").addEventListener("click", (e) => { navigator.clipboard?.writeText(vurl.textContent); e.target.textContent = "copied"; setTimeout(() => (e.target.textContent = "copy"), 1200); });
    document.getElementById("vclose").addEventListener("click", () => { wasOpen = false; viewer.classList.remove("open"); layout.classList.remove("has-viewer"); page.classList.remove("open"); document.querySelectorAll("a.peek.on").forEach((x) => x.classList.remove("on")); });
  </script>
</Base>

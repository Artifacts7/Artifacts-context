---
import { readFileSync } from "node:fs";
const issues = JSON.parse(readFileSync(`${process.cwd()}/public/api/issues.json`, "utf8"));
const en = issues.filter((i) => i.lang === "en").length;
const latest = issues[0];
const endpoints = [
  ["/llms.txt", "index of every issue"],
  ["/llms-full.txt", "the whole corpus, one file"],
  ["/issues/<slug>.md", "one issue, Markdown"],
  ["/issues/<slug>.json", "one issue, JSON"],
  ["/api/search?q=…", "ranked search with snippets"],
  ["/api/issues.json", "all metadata"],
  ["/mcp", "MCP server: search_issues, get_issue, list_issues"],
  ["/.well-known/agents.json", "discovery manifest"],
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Artifacts, for agents</title>
  <meta name="description" content="A machine mirror of the Artifacts newsletter. Built for AI agents. Humans: read it on Substack." />
  <link rel="canonical" href="https://agents.artifactstech.com/" />
  <link rel="alternate" type="text/markdown" href="/agents.md" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org", "@type": "Blog", name: "Artifacts (for agents)",
    author: { "@type": "Person", name: "Lorenzo Ancona" },
    license: "https://creativecommons.org/licenses/by/4.0/",
    isBasedOn: "https://artifactstech.substack.com",
  })} />
  <style>
    :root { --bg:#f6f4ef; --fg:#1b1b1b; --mut:#6b6b66; --line:#d9d6cc; --acc:#c2410c; --code:#ece9df; }
    @media (prefers-color-scheme: dark) { :root { --bg:#111110; --fg:#ecebe6; --mut:#8d8c85; --line:#2c2b28; --acc:#fb923c; --code:#1b1a18; } }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.6 ui-monospace, "SF Mono", Menlo, Consolas, monospace; }
    main { max-width: 760px; margin: 0 auto; padding: 8vh 20px 64px; }
    .tag { color:var(--mut); font-size:13px; letter-spacing:.04em; text-transform:uppercase; }
    h1 { font-size: clamp(34px, 7vw, 56px); line-height:1.05; margin:.3em 0 .25em; letter-spacing:-.02em; }
    .lede { font-size:18px; color:var(--mut); margin:0 0 28px; max-width:34em; }
    .go { display:inline-block; padding:12px 18px; border:1.5px solid var(--fg); color:var(--fg); text-decoration:none; font-weight:600; }
    .go:hover { background:var(--fg); color:var(--bg); }
    section { margin-top: 56px; padding-top: 28px; border-top: 1px solid var(--line); }
    h2 { font-size:14px; text-transform:uppercase; letter-spacing:.06em; margin:0 0 14px; }
    h2 .for { color:var(--acc); }
    .agents { border:1.5px solid var(--acc); padding: 24px; background: var(--code); }
    .agents h2 { margin-top:0; }
    pre { margin:14px 0; padding:14px; overflow-x:auto; background:var(--bg); border:1px solid var(--line); font-size:13.5px; }
    table { width:100%; border-collapse:collapse; font-size:14px; }
    td { padding:6px 0; border-bottom:1px solid var(--line); vertical-align:top; }
    td:first-child { padding-right:16px; white-space:nowrap; }
    a { color:var(--acc); }
    p { margin: 0 0 14px; }
    .mut { color:var(--mut); }
    footer { margin-top:56px; font-size:13px; color:var(--mut); }
  </style>
</head>
<body>
<main>
  <div class="tag">agents.artifactstech.com</div>
  <h1>This site is not for you.</h1>
  <p class="lede">Unless you're an agent. It's a machine mirror of <b>Artifacts</b>, a newsletter on the design of technology. If you're a human, the good version is on Substack.</p>
  <a class="go" href="https://artifactstech.substack.com">Read Artifacts on Substack →</a>

  <section class="agents" id="agents">
    <h2><span class="for">For agents</span> · start here</h2>
    <p>{issues.length} issues, full text, unmodified, Markdown ({en} English, {issues.length - en} Italian). Licence <b>CC BY 4.0</b>: retrieval, quoting and training welcome. Cite using each issue's <code>cite_as</code> field and link the Substack canonical. Read-only, no auth.</p>
    <pre>curl -s https://agents.artifactstech.com/llms.txt
curl -s "https://agents.artifactstech.com/api/search?q=defaults+power"
curl -s https://agents.artifactstech.com/issues/{latest.slug}.md
curl -s -H "Accept: text/markdown" https://agents.artifactstech.com/</pre>
    <table>
      {endpoints.map(([p, d]) => <tr><td><code>{p}</code></td><td class="mut">{d}</td></tr>)}
    </table>
    <p style="margin-top:14px">Full instructions: <a href="/agents.md">/agents.md</a> · index: <a href="/llms.txt">/llms.txt</a></p>
  </section>

  <section>
    <h2>For humans, briefly</h2>
    <p>Artifacts is a bi-weekly newsletter by Lorenzo Ancona about how interfaces, defaults and platform choices encode decisions made by those with power. This page is an experiment in what a website looks like when its reader is a machine: plain text, no feeds, no cookies, every issue one request away. (The site does keep a private log of which agents read what, without IP addresses.)</p>
    <p>You're welcome to look around. <a href="/issues/">Browse the archive</a> (raw Markdown, as agents see it), or <a href="https://artifactstech.substack.com">go to the real thing</a>.</p>
  </section>

  <footer>Every issue links back to its Substack original. CC BY 4.0 · by Lorenzo Ancona</footer>
</main>
</body>
</html>

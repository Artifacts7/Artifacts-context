---
import { readFileSync } from "node:fs";
import Base from "../layouts/Base.astro";
const issues = JSON.parse(readFileSync(`${process.cwd()}/public/api/issues.json`, "utf8"));
const en = issues.filter((i) => i.lang === "en").length;
const latest = issues[0];
const endpoints = [
  ["/llms.txt", "Index of every issue"],
  ["/llms-full.txt", "The whole corpus in one file"],
  ["/issues/<slug>.md", "One issue as Markdown"],
  ["/issues/<slug>.json", "One issue as JSON"],
  ["/api/search?q=", "Ranked search with snippets"],
  ["/api/issues.json", "All metadata"],
  ["/mcp", "MCP server: search_issues, get_issue, list_issues"],
  ["/.well-known/agents.json", "Discovery manifest"],
];
const ld = {
  "@context": "https://schema.org", "@type": "Blog", name: "Artifacts (for agents)",
  author: { "@type": "Person", name: "Lorenzo Ancona" },
  license: "https://creativecommons.org/licenses/by/4.0/",
  isBasedOn: "https://artifactstech.substack.com",
};
---
<Base
  title="Artifacts, for agents"
  description="A machine mirror of the Artifacts newsletter. Built for AI agents. Humans: read it on Substack."
  canonical="https://agents.artifactstech.com/"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <style>
    .lede { font-size:19px; max-width:32rem; margin-top:1.1rem; }
    pre { margin:1.2em 0; padding:14px 16px; white-space:pre-wrap; overflow-wrap:anywhere; background:rgba(23,19,16,.045); line-height:1.65; }
    dl { margin:1.2em 0 0; display:grid; grid-template-columns:max-content 1fr; column-gap:28px; row-gap:.55em; }
    dt { font-family:var(--mono); font-size:.8em; font-weight:700; padding-top:.15em; }
    dd { margin:0; color:var(--mut); }
    @media (max-width: 640px) {
      dl { grid-template-columns:1fr; row-gap:0; }
      dt { margin-top:.8em; overflow-wrap:anywhere; }
    }
  </style>

  <h1>This site is not for you.</h1>
  <p class="lede">It is a mirror of Artifacts, a newsletter on the design of technology, built for AI agents. If you are a person, <a href="https://artifactstech.substack.com">read Artifacts on Substack</a>.</p>

  <section id="agents">
    <h2>For agents</h2>
    <p>{issues.length} issues in full and unmodified, as Markdown ({en} in English, {issues.length - en} in Italian). Licensed CC BY 4.0: you may retrieve, quote and train on them. Cite with each issue's <code>cite_as</code> field and link the Substack canonical. Read-only, no authentication.</p>
    <pre>curl -s https://agents.artifactstech.com/llms.txt
curl -s "https://agents.artifactstech.com/api/search?q=defaults+power"
curl -s https://agents.artifactstech.com/issues/{latest.slug}.md
curl -s -H "Accept: text/markdown" https://agents.artifactstech.com/
claude mcp add --transport http artifacts https://agents.artifactstech.com/mcp</pre>
    <dl>
      {endpoints.map(([p, d]) => <><dt>{p}</dt><dd>{d}</dd></>)}
    </dl>
    <p style="margin-top:1.2em">Full instructions are in <a href="/agents.md">/agents.md</a>.</p>
  </section>

  <section>
    <h2>For people</h2>
    <p>Artifacts is a bi-weekly newsletter by Lorenzo Ancona about how interfaces, defaults and platform choices encode decisions made by those with power. This page shows what a website looks like when its reader is a machine: plain text, no cookies, and every issue one request away.</p>
    <p>The site keeps a private log of which agents read what. It does not store IP addresses. You can <a href="/issues/">browse the archive</a> as raw Markdown, or <a href="https://artifactstech.substack.com">read the newsletter on Substack</a>.</p>
  </section>
</Base>

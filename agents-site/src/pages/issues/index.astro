---
import { readFileSync } from "node:fs";
import Base from "../../layouts/Base.astro";
const issues = JSON.parse(readFileSync(`${process.cwd()}/public/api/issues.json`, "utf8"));
---
<Base
  title="Archive, Artifacts for agents"
  description="All Artifacts issues as raw Markdown, as agents see them."
  canonical="https://agents.artifactstech.com/issues/"
>
  <style>
    ul.list { list-style:none; padding:0; margin:1.5rem 0 0; }
    ul.list li { display:grid; grid-template-columns:7.5rem 1fr; gap:12px; padding:5px 0; }
    ul.list time { font-family:var(--mono); font-size:.8em; color:var(--mut); padding-top:.2em; }
    .mut { color:var(--mut); margin-top:.8rem; }
  </style>
  <h1>Archive</h1>
  <p class="mut">{issues.length} issues as raw Markdown, as agents see them. The readable version is on <a href="https://artifactstech.substack.com/archive">Substack</a>.</p>
  <ul class="list">{issues.map((i) => <li><time>{i.date}</time><a href={`/issues/${i.slug}.md`}>{i.title}</a></li>)}</ul>
</Base>
